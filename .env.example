# Copy this file to .env and fill in your own keys. .env is git-ignored.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides
# EXTRACT_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=medium
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=
# MAX_ATTEMPTS=3
# OUTPUT_DIR=out

# If set, POST /briefings requires X-Timestamp (Unix seconds) and
# X-Signature: sha256=<hex HMAC-SHA256 of "<timestamp>.<raw body>" using this secret>.
# Requests older than 5 minutes are refused.
# WEBHOOK_SECRET=
